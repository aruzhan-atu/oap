
import re

def process_variant_3(text, search_word, old_word, new_word, code):
    # 5-шарт: Бос мәтін немесе тек бос орын кездескен жағдайды өңдеу
    if not text or text.strip() == "":
        return {"Қате": "Мәтін бос немесе тек бос орындардан тұрады!"}
    
    # 1) Бастапқы мәтіннің ұзындығын, сөз санын, бос орын емес таңбалар санын есептеу
    text_length = len(text)
    word_count = len(text.split())
    non_space_count = len([char for char in text if not char.isspace()])
    
    # 2) Іздеу сөзінің алғашқы индексін және кездесулер санын табу (регистрге тәуелсіз)
    text_lower = text.lower()
    search_word_lower = search_word.lower()
    
    first_index = text_lower.find(search_word_lower)
    occurrence_count = text_lower.count(search_word_lower)
    
    if first_index == -1:
        search_status = f"'{search_word}' сөзі мәтіннен табылмады."
    else:
        search_status = f"Алғашқы индекс: {first_index}, Жалпы саны: {occurrence_count}"
        
    # 3) Берілген сөзді жаңа сөзге алмастыру
    modified_text = text.replace(old_word, new_word)
    
    # 4) Берілген кодтың ХХ-999 үлгісіне сәйкестігін тексеру
    code_pattern = r'^[A-Z]{2}-\d{3}$'
    if re.match(code_pattern, code):
        code_status = f"'{code}' коды ХХ-999 үлгісіне СӘЙКЕС КЕЛЕДІ."
    else:
        code_status = f"'{code}' коды ХХ-999 үлгісіне СӘЙКЕС КЕЛМЕЙДІ (Қате пішім)."
        
    return {
        "Мәтін ұзындығы": text_length,
        "Сөз саны": word_count,
        "Бос орын емес таңбалар саны": non_space_count,
        "Іздеу нәтижесі (регистрсіз)": search_status,
        "Өзгертілген мәтін": modified_text,
        "Кодты тексеру нәтижесі": code_status
    }

