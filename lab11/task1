# 1. Бастапқы деректерді құру
# Кемінде 10 элементтен тұратын және ішінде қайталанулары бар тауар санаттары
toy_categories = [
    "Электроника", "Киім", "Азық-түлік", "Электроника", "Кітаптар",
    "Киім", "Азық-түлік", "Спорт", "Электроника", "Кітаптар"
]

# Кемінде 4 жазбадан тұратын тауарлар сөздігінің тізімі
products = [
    {"атауы": "Құлаққап", "санаты": "Электроника", "бағасы": 45},
    {"атауы": "Күртеше", "санаты": "Киім", "бағасы": 120},
    {"атауы": "Футбол добы", "санаты": "Спорт", "бағасы": 85},
    {"атауы": "Смарт-сағат", "санаты": "Электроника", "бағасы": 65},
    {"атауы": "Сөздік кітап", "санаты": "Кітаптар", "бағасы": 90}
]

print("--- БАСТАПҚЫ ДЕРЕКТЕР ---")
print(f"Тауар санаттарының тізімі: {toy_categories}")
print("Тауарлар тізімі:")
for p in products:
    print(p)
print("-" * 40)


# 2. А тапсырмасы: Бірегей санаттарды анықтау және қайталанатын мәндер санын табу
unique_categories = set(toy_categories)
total_elements = len(toy_categories)
unique_elements_count = len(unique_categories)
duplicated_count = total_elements - unique_elements_count

print("\n--- А ТАПСЫРМАСЫ ---")
print(f"Бірегей санаттар жиыны: {unique_categories}")
print(f"Жалпы элементтер саны: {total_elements}")
print(f"Бірегей элементтер саны: {unique_elements_count}")
print(f"Қайталанатын элементтер саны: {duplicated_count}")


# 3. Ә тапсырмасы: Санаттардың кездесу жиілігін dict арқылы есептеу
category_frequency = {}
for cat in toy_categories:
    if cat in category_frequency:
        category_frequency[cat] += 1
    else:
        category_frequency[cat] = 1

print("\n--- Ә ТАПСЫРМАСЫ ---")
print("Санаттардың кездесу жиілігі:")
for cat, freq in category_frequency.items():
    print(f" - {cat}: {freq} рет")


# 4. Б тапсырмасы (Шарт бойынша іріктеу): «Бағасы 70-тен жоғары тауарлар»
filtered_products = [p for p in products if p["бағасы"] > 70]

print("\n--- Б ТАПСЫРМАСЫ (ІРІКТЕУ) ---")
print("Бағасы 70-тен жоғары тауарлар:")
for p in filtered_products:
    print(f" - {p['атауы']} (бағасы: {p['бағасы']}), санаты: {p['санаты']}")


# 5. Б тапсырмасы (Өрісті жаңарту): Бір жазбаның бір өрісін өзгерту
print("\n--- Б ТАПСЫРМАСЫ (ӨЗГЕРТУ) ---")
print(f"Өзгертуге дейінгі бірінші тауар: {products[0]}")

# "Құлаққап" тауарының бағасын жаңартамыз
products[0]["бағасы"] = 55 

print(f"Өзгертуден кейінгі бірінші тауар: {products[0]}")

