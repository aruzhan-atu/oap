# 3-нұсқа. Дүкен

# ==========================================
# 1. БАСТАПҚЫ ДЕРЕКТЕР
# ==========================================
# Кемінде 10 элементтен тұратын және кемінде 3 қайталануы бар санаттар тізімі
категориялар = [
    "Электроника", "Киім", "Электроника", "Кітаптар", "Азық-түлік",
    "Киім", "Электроника", "Ойыншықтар", "Азық-түлік", "Кітаптар"
]

# «атауы, санаты, бағасы» өрістері бар кемінде 4 жазба (сөздіктер тізімі)
тауарлар = [
    {"атауы": "Смартфон", "санаты": "Электроника", "бағасы": 120000},
    {"атауы": "Футболка", "санаты": "Киім", "бағасы": 4500},
    {"атауы": "Шоколад", "санаты": "Азық-түлік", "бағасы": 800},
    {"атауы": "Шаңсорғыш", "санаты": "Электроника", "бағасы": 45000},
    {"атауы": "Көркем әдебиет", "санаты": "Кітаптар", "бағасы": 2500}
]


# ==========================================
# А ТАПСЫРМАСЫ: Бірегей мәндер және қайталану саны
# ==========================================
бірегей_категориялар = set(категориялар)
қайталанатын_элементтер_саны = len(категориялар) - len(бірегей_категориялар)

print("--- А ТАПСЫРМАСЫ ---")
print(f"Бастапқы тізім: {категориялар}")
print(f"Бірегей мәндер жиыны: {бірегей_категориялар}")
print(f"Қайталанатын элементтер саны: {қайталанатын_элементтер_саны}\n")


# ==========================================
# Ә ТАПСЫРМАСЫ: Санаттардың жиілігін dict арқылы есептеу
# ==========================================
жиілік_сөздігі = {}
for санат in категориялар:
    жиілік_сөздігі[санат] = жиілік_сөздігі.get(санат, 0) + 1

# Ең жиі кездесетін мәнді анықтау (теңдік болса, бәрін көрсету)
макс_жиілік = max(жиілік_сөздігі.values())
ең_жиі_мәндер = [кілт for кілт, мән in жиілік_сөздігі.items() if мән == макс_жиілік]

print("--- Ә ТАПСЫРМАСЫ ---")
print(f"Санаттардың кездесу жиілігі (dict): {жиілік_сөздігі}")
print(f"Ең жиі кездесетін санат(тар) (жиілігі {макс_жиілік}): {', '.join(ең_жиі_мәндер)}\n")


# ==========================================
# Б ТАПСЫРМАСЫ: Іріктеу және Жазбаны өзгерту
# ==========================================
print("--- Б ТАПСЫРМАСЫ ---")
# 1. Шарт бойынша іріктеу: «бағасы 3000-нан жоғары тауарлар»
іріктелген_тауарлар = [тауар for тауар in тауарлар if тауар["бағасы"] > 3000]

print("Бағасы 3000-нан жоғары тауарлар:")
for т in іріктелген_тауарлар:
    print(f" - {т['атауы']} ({т['санаты']}): {т['бағасы']} тг")

# 2. Бір жазбаның бір өрісін өзгерту
print("\nӨзгертуге дейінгі алғашқы тауар:", тауарлар[0])
# Смартфонның бағасын өзгертеміз
тауарлар[0]["бағасы"] = 115000 
print("Өзгерістен кейінгі алғашқы тауар:", тауарлар[0], "\n")


# ==========================================
# В ТАПСЫРМАСЫ: Ерекше жағдайларды тексеру функциясы
# ==========================================
def тексеру_жағдайлары(тізім, атауы):
    if not тізім:
        print(f"[{атауы}]: Тізім бос!")
        return
    жиын = set(тізім)
    if len(жиын) == len(тізім):
        print(f"[{атауы}]: Қайталанусыз кіріс (барлық мәндер бірегей).")
    elif len(жиын) == 1:
        print(f"[{атауы}]: Барлық мәндері бірдей кіріс жағдайы.")
    else:
        print(f"[{атауы}]: Қалыпты аралас тізім.")

print("--- В ТАПСЫРМАСЫ (Ерекше жағдайларды тексеру) ---")
тексеру_жағдайлары([], "Бос кіріс")
тексеру_жағдайлары(["Кітап", "Киім", "Азық-түлік"], "Қайталанусыз кіріс")
тексеру_жағдайлары(["Киім", "Киім", "Киім"], "Барлық мәндері бірдей кіріс")
тексеру_жағдайлары(категориялар, "Негізгі категориялар тізімі")

