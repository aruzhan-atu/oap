def process_expense(balance, expense):
    # Қате 1: Шығыс баланстан асып кетсе де азайта береді (баланс минусқа кетеді)
    # Қате 2: Теріс шығыс енгізілсе, баланс керісінше көбейіп кетеді
    return balance - expense

# Қатені қайталау мысалдары:
print("Артық шығыс:", process_expense(1000, 1500))
print("Теріс шығыс:", process_expense(500, -1))
